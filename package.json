{
  "name": "click-outside-vue3",
  "version": "4.1.0",
  "description": "Vue 3 directive to react on clicks outside an element",
  "main": "dist/v-click-outside.umd.js",
  "types": "src/index.d.ts",
  "umd:main": "dist/v-click-outside.umd.js",
  "source": "src/index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --colors --watch",
    "test:types": "tsc -p test/types",
    "test:compat": "node scripts/compat/run.mjs",
    "coverage": "open coverage/lcov-report/index.html",
    "build": "microbundle --entry src/index.js --target browser --format umd --name v-click-outside --tsconfig tsconfig.build.json",
    "lint": "eslint . --ext .js,.mjs,.vue",
    "example:dev": "vite example",
    "example:build": "vite build example",
    "format": "prettier --write '**/*.{js,json,md}'",
    "format:changed": "pretty-quick",
    "format:staged": "pretty-quick --staged",
    "release": "np",
    "version": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andymark-by/click-outside-vue3.git"
  },
  "author": "ndelvalle <nicolas.delvalle@gmail.com>",
  "keywords": [
    "vue3",
    "click outside",
    "click"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andymark-by/click-outside-vue3/issues"
  },
  "homepage": "https://github.com/andymark-by/click-outside-vue3#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.11.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "babel-core": "^6.26.3",
    "babel-jest": "^26.3.0",
    "babel-preset-es2015": "^6.24.1",
    "eslint": "^7.7.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^7.1.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-vue": "^7.20.0",
    "husky": "^4.2.5",
    "jest": "^26.4.2",
    "jest-cli": "^26.4.2",
    "lodash": "^4.17.20",
    "microbundle": "^0.13.0",
    "np": "^7.2.0",
    "prettier": "^2.1.1",
    "pretty-quick": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "roots": [
      "test/"
    ]
  },
  "engines": {
    "node": ">=6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0"
    }
  }
}
